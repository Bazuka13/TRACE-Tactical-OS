# Virtual Environment
.venv/
env/
venv/

# Dependencies & Build Artefacts
node_modules/
dist/
frontend/dist/

# Python Cache & Training Logs
__pycache__/
*.py[cod]
*.log
ingest_errors.log
catboost_info/

